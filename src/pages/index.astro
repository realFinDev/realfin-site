---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { CATEGORIES, GUEST_AUTHORING } from '../consts';
import { getPosts } from '../lib';
import { TOOLS } from '../tools';
const posts = await getPosts();
const latest = posts.slice(0, 6);
const activeCats = Object.entries(CATEGORIES).filter(([key]) => posts.some((p) => p.data.category === key));
const startHere = ['homelab-tour-30-containers', 'homelab-security-no-port-forwards', 'valheim-dedicated-server-docker']
  .map((id) => posts.find((p) => p.id === id))
  .filter((p) => p !== undefined);
---
<Base>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'RealFin',
    url: 'https://realfin.dev/',
    description: 'Homelab, self-hosting and game servers, written up from a real server. Plus building a Roblox game with AI.',
    publisher: { '@type': 'Person', name: 'RealFin', url: 'https://realfin.dev/authors/realfin/' },
  })} />
  <h1>A real homelab, written down.</h1>
  <p class="lede">
    One home server, about thirty Docker containers: media, smart home, DNS, a local AI and game servers for friends.
    This is where I write up how it works, what broke and how I fixed it, plus building a Roblox game with AI.
    {GUEST_AUTHORING && <a href="/write/">Other people's first-hand stories are welcome too.</a>}
  </p>
  <h2 class="sr-only">Topics</h2>
  <div class="cats">
    {activeCats.map(([key, c]) => (
      <a class="card" href={`/category/${key}/`} style="text-decoration:none">
        <h3 style="margin-top:0;color:var(--text)">{c.label}</h3>
        <p>{c.blurb}</p>
      </a>
    ))}
  </div>

  {startHere.length > 0 && (
    <section>
      <h2>Start here</h2>
      <ul class="cards">{startHere.map((post) => <PostCard post={post} />)}</ul>
    </section>
  )}

  <section>
    <h2>Free tools</h2>
    <div class="cats">
      {TOOLS.map((t) => (
        <a class="card" href={t.href} style="text-decoration:none">
          <h3 style="margin-top:0;color:var(--text)">{t.title}</h3>
          <p>{t.short}</p>
        </a>
      ))}
    </div>
  </section>

  <h2>Latest posts</h2>
  <ul class="cards">
    {latest.map((post) => <PostCard post={post} />)}
  </ul>
  <p><a href="/blog/">All {posts.length} posts →</a> · <a href="/search/">Search</a> · <a href="/rss.xml">RSS</a></p>
</Base>
