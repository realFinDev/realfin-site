---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { CATEGORIES, SERIES, type Category } from '../../consts';
import { getPosts } from '../../lib';
import { TOOLS } from '../../tools';

export function getStaticPaths() {
  return Object.keys(CATEGORIES).map((category) => ({ params: { category } }));
}
const category = Astro.params.category as Category;
const c = CATEGORIES[category];
const posts = (await getPosts()).filter((p) => p.data.category === category);
// Series whose posts are mostly in this category.
const tools = TOOLS.filter((t) => t.category === category);
const series = Object.values(SERIES).filter((s) => s.posts.filter((id) => posts.some((p) => p.id === id)).length > s.posts.length / 2);
---
<Base title={c.label} description={c.blurb} noindex={posts.length === 0}>
  <h1>{c.label}</h1>
  <p class="lede">{c.blurb}</p>
  {series.length > 0 && (
    <p>Read in order: {series.map((s, i) => <>{i > 0 && ' · '}<a href={`/blog/${s.posts[0]}/`}>{s.title}</a></>)}</p>
  )}
  {tools.length > 0 && (
    <p>Tools: {tools.map((t, i) => <>{i > 0 && ' · '}<a href={t.href}>{t.title}</a></>)}</p>
  )}
  {posts.length > 0
    ? <ul class="cards">{posts.map((post) => <PostCard post={post} />)}</ul>
    : <p>First posts are on the way.</p>}
</Base>
