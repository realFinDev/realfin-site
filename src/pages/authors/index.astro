---
import Base from '../../layouts/Base.astro';
import { getAuthors, getPosts, avatarOf } from '../../lib';
import { GUEST_AUTHORING } from '../../consts';
const authors = await getAuthors();
const posts = await getPosts();
const count = (id: string) => posts.filter((p) => p.data.author.id === id).length;
const sorted = authors.sort((a, b) => count(b.id) - count(a.id));
---
<Base title="Authors" description="The people writing on RealFin, and how to join them.">
  <h1>Authors</h1>
  <p class="lede">Real people writing about things they actually built, broke and fixed. {GUEST_AUTHORING && <a href="/write/">Want to write here?</a>}</p>
  <h2 class="sr-only">All authors</h2>
  <ul class="cards">
    {sorted.map((a) => (
      <li class="card author-card">
        <img src={avatarOf(a)} alt="" width="48" height="48" loading="lazy" />
        <div>
          <h3><a href={`/authors/${a.id}/`}>{a.data.name}</a></h3>
          <p>{a.data.bio}</p>
          <div class="meta">{count(a.id)} {count(a.id) === 1 ? 'post' : 'posts'}{a.data.role === 'editor' && ' · Editor'}</div>
        </div>
      </li>
    ))}
  </ul>
</Base>
