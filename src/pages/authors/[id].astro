---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import { getAuthors, getPosts } from '../../lib';

export async function getStaticPaths() {
  const authors = await getAuthors();
  return authors.map((author) => ({ params: { id: author.id }, props: { author } }));
}
const { author } = Astro.props;
const posts = (await getPosts()).filter((p) => p.data.author.id === author.id);
---
<Base title={author.data.name} description={author.data.bio} author={author.id}>
  <h1>{author.data.name}</h1>
  <AuthorBox author={author} label="" />
  <h2>Posts by {author.data.name}</h2>
  {posts.length > 0
    ? <ul class="cards">{posts.map((post) => <PostCard post={post} />)}</ul>
    : <p>No published posts yet.</p>}
</Base>
