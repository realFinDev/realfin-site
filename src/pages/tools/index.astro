---
import Base from '../../layouts/Base.astro';
import { TOOLS as tools } from '../../tools';
import { CATEGORIES, type Category } from '../../consts';
const groups = (['game-servers', 'homelab', 'roblox'] as Category[]).map((c) => ({ c, label: CATEGORIES[c].label, items: tools.filter((t) => t.category === c) })).filter((g) => g.items.length);
---
<Base title="Tools" description="Small free tools for homelab and game server admins: Valheim server arguments, DNS record checker, Docker Compose port checker. They run in your browser.">
  <h1>Tools</h1>
  <p class="lede">Small helpers I wanted for my own homelab. They run in your browser. The port checker, log helper, Minecraft, Roblox and Valheim tools send nothing anywhere; the DNS checker asks Cloudflare's and Google's public DNS directly, never this site.</p>
  {groups.map((g) => (
    <section>
      <h2>{g.label}</h2>
      <ul class="cards">
        {g.items.map((t) => (
          <li class="card"><h3><a href={t.href}>{t.title}</a></h3><p>{t.text}</p></li>
        ))}
      </ul>
    </section>
  ))}
  <section>
    <h2>Scripts</h2>
    <ul class="cards">
      <li class="card">
        <h3><a href="/blog/homelab-health-check-checklist/">Homelab health check (bash)</a></h3>
        <p>A read-only script that finds crash-looping containers, failed services, missing log limits, an NVIDIA driver mismatch, full disks and noisy logs. <a href="https://github.com/realFinDev/realfin-site/blob/main/public/downloads/homelab-healthcheck.sh">Read it</a> · <a href="/downloads/homelab-healthcheck.sh">download</a></p>
      </li>
    </ul>
  </section>
</Base>
