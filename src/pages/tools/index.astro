---
import Base from '../../layouts/Base.astro';
import { TOOLS as tools } from '../../tools';
import { CATEGORIES, type Category } from '../../consts';
const groups = (['game-servers', 'homelab', 'roblox'] as Category[]).map((c) => ({ c, label: CATEGORIES[c].label, items: tools.filter((t) => t.category === c) })).filter((g) => g.items.length);
---
<Base title="Tools" description="Small free tools for homelab and game server admins: Valheim server arguments, DNS record checker, Docker Compose port checker. They run in your browser.">
  <h1>Tools</h1>
  <p class="lede">Small helpers I wanted for my own homelab. They run in your browser. The port checker, log helper, Roblox and Valheim tools send nothing anywhere; the DNS checker asks Cloudflare's and Google's public DNS directly, never this site.</p>
  {groups.map((g) => (
    <section>
      <h2>{g.label}</h2>
      <ul class="cards">
        {g.items.map((t) => (
          <li class="card"><h3><a href={t.href}>{t.title}</a></h3><p>{t.text}</p></li>
        ))}
      </ul>
    </section>
  ))}
</Base>
