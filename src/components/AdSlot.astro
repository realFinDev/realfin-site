---
import { ADSENSE_CLIENT } from '../consts';
// Manual ad unit. Renders nothing until ADSENSE_CLIENT is set.
// Auto ads (configured in the AdSense dashboard) also work without this component.
interface Props { slot?: string }
const { slot = '' } = Astro.props;
---
{ADSENSE_CLIENT && slot && (
  <div class="ad-slot">
    <ins class="adsbygoogle" style="display:block" data-ad-client={ADSENSE_CLIENT} data-ad-slot={slot} data-ad-format="auto" data-full-width-responsive="true"></ins>
    <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
  </div>
)}
