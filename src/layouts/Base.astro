---
import '../styles/global.css';
import { SITE_TITLE, SITE_DESCRIPTION, ADSENSE_CLIENT, IS_PRODUCTION } from '../consts';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  /** false = don't load the AdSense script on this page at all */
  ads?: boolean;
  /** author id, exposed for later per-author ad revenue attribution */
  author?: string;
  /** social preview image path under /public */
  image?: string;
  /** keep this page out of search engines (e.g. empty listings) */
  noindex?: boolean;
}
const { title, description = SITE_DESCRIPTION, type = 'website', ads = true, author, image = '/og/default.png', noindex = false } = Astro.props;
const imageUrl = new URL(image, Astro.site);
const loadAds = Boolean(ADSENSE_CLIENT) && ads && IS_PRODUCTION;
const fullTitle = title ? `${title} · ${SITE_TITLE}` : `${SITE_TITLE}: homelab, game servers & Roblox dev`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const nav = [
  { href: '/', label: 'Home' },
  { href: '/blog/', label: 'Blog' },
  { href: '/homelab/', label: 'My homelab' },
  { href: '/tools/', label: 'Tools' },
  { href: '/authors/', label: 'Authors' },
  { href: '/search/', label: 'Search' },
  { href: '/about/', label: 'About' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(!IS_PRODUCTION || noindex) && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="RealFin" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={imageUrl} />
    {author && <meta name="author" content={author} />}
    {loadAds && (
      <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`} crossorigin="anonymous"></script>
    )}
  </head>
  <body data-author={author}>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site">
      <div class="wrap">
        <a class="brand" href="/">Real<span>Fin</span></a>
        <nav class="main" aria-label="Main">
          {nav.map((n) => (
            <a href={n.href} aria-current={(n.href === '/' ? path === '/' : path.startsWith(n.href)) ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main class="wrap" id="main">
      <slot />
    </main>
    <footer class="site">
      <div class="wrap">
        <nav aria-label="Footer">
          <a href="/about/">About</a>
          <a href="/write/">Write for us</a>
          <a href="/contact/">Contact</a>
          <a href="/privacy/">Privacy policy</a>
          <a href="/rss.xml">RSS</a>
        </nav>
        <div>© {new Date().getFullYear()} RealFin. Written from a real homelab.</div>
      </div>
    </footer>
  </body>
</html>
